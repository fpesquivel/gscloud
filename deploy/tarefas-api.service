[Unit]
Description=API de Tarefas (FastAPI + Gunicorn + SQLite)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/tarefas-api
Environment="DATABASE_URL=sqlite:////var/lib/tarefas-api/tarefas.db"
ExecStart=/opt/tarefas-api/venv/bin/gunicorn app.main:app --workers 2 --worker-class uvicorn.workers.UvicornWorker --bind 127.0.0.1:8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
